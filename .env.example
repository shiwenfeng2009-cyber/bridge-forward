# Bridge Forward local/deployment environment
#
# Safe to expose in browser. Use the Supabase Project Settings > API values.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Runtime aliases for Cloudflare/OpenNext server rendering. Use the same
# public project URL and publishable/anon key; never use the service-role key.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# Public site URL used for auth email confirmation redirects.
# Local:
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Production example:
# NEXT_PUBLIC_SITE_URL="https://your-vercel-project.vercel.app"
